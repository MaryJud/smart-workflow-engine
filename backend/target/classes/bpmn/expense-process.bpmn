      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_00q87ty_di" bpmnElement="EndEvent_AutoApproved">
        <dc:Bounds x="452" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="427" y="278" width="86" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1x0j4jj_di" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="842" y="232" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840" y="275" width="41" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_1rqvsze_di" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="842" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="826" y="155" width="68" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0s2jdt5_di" bpmnElement="Flow_0s2jdt5">
        <di:waypoint x="218" y="130" />
        <di:waypoint x="280" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0zlo4ud_di" bpmnElement="Flow_0zlo4ud">
        <di:waypoint x="380" y="130" />
        <di:waypoint x="445" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0sm1xbi_di" bpmnElement="Flow_ApprovalManager">
        <di:waypoint x="495" y="130" />
        <di:waypoint x="560" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0141bjm_di" bpmnElement="Flow_0141bjm">
        <di:waypoint x="660" y="130" />
        <di:waypoint x="725" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1d0e621_di" bpmnElement="Flow_AutoApproved">
        <di:waypoint x="470" y="155" />
        <di:waypoint x="470" y="232" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="799" y="162" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0vhmrkh_di" bpmnElement="Flow_Approved">
        <di:waypoint x="775" y="130" />
        <di:waypoint x="842" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1xjkubq_di" bpmnElement="Flow_Rejected">
        <di:waypoint x="750" y="155" />
